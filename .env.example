# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./data/app.db

# Storage Directories
DATA_DIR=data
UPLOADS_DIR=data/uploads
VIDEOS_DIR=data/videos
DETECTIONS_DIR=data/detections
EXPORTS_DIR=data/exports

# Model Weights
HUMAN_MODEL_PATH=models/human/yolo11n.pt
WEAPON_MODEL_PATH=models/weapon/best.pt
POSE_MODEL_PATH=models/pose/yolo11n-pose.pt

# Inference Thresholds
HUMAN_CONF_THRESHOLD=0.45
WEAPON_CONF_THRESHOLD=0.50
POSE_CONF_THRESHOLD=0.50
ASSOCIATION_DISTANCE_THRESHOLD=120.0
ASSOCIATION_IOU_THRESHOLD=0.15

# Hardware Settings (cuda, cpu, or auto)
DEVICE=auto

# Video Processing Defaults
MAX_FPS=30
FRAME_SKIP=0
JPEG_QUALITY=80
